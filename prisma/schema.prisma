// Lender partnership outreach CRM. Separate from the marketing site's
// content model in src/data: this schema holds operational state (contacts,
// messages, replies, approvals), not published copy.
//
//   pnpm db:generate   # regenerate the client after any change here
//   pnpm db:push       # sync schema to DATABASE_URL (dev)
//   pnpm db:migrate    # create a tracked migration (use for prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LenderStatus {
  NEW // seeded, no contact discovery run yet
  CONTACT_NEEDED // discovery ran, found nothing usable, needs manual research
  READY // has an approved contact, no outreach sent yet
  CONTACTED // proposal sent, awaiting reply
  REPLIED // a reply came in, awaiting triage or action
  INTERESTED
  CALL_SCHEDULED
  ONBOARDING
  PARTNERSHIP_LIVE
  NOT_INTERESTED
  WRONG_CONTACT
  ON_HOLD
  OPTED_OUT
}

enum ContactConfidence {
  HIGH // named partnership/DSA/alliances contact, or a role inbox explicitly for channel partners
  MEDIUM // general business or sales inbox that plausibly reaches the right team
  LOW // best-guess pattern or generic info/support inbox, needs a human check before sending
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageKind {
  PROPOSAL
  FOLLOW_UP
  REPLY
}

enum MessageStatus {
  DRAFT // AI generated, not yet reviewed
  PENDING_APPROVAL // queued for a human
  APPROVED // approved, about to be sent
  QUEUED // rate-limited, waiting for a send slot
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
  SKIPPED // human chose not to send this one
}

enum ReplyClassification {
  INTERESTED
  NEEDS_INFO
  REQUEST_CALL
  NOT_INTERESTED
  WRONG_CONTACT
  NEEDS_DOCUMENTS
  FOLLOW_UP_LATER
  OUT_OF_OFFICE
  UNSUBSCRIBE
  UNCLEAR
}

model Lender {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  website   String
  type      String
  products  String[]
  strengths String[]
  summary   String
  bestFor   String
  status    LenderStatus @default(NEW)
  pausedUntil DateTime? // paused for follow-ups / re-contact (e.g. "circle back in Q3")

  contacts Contact[]
  messages OutreachMessage[]
  notes    Note[]
  activity ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Contact {
  id         String            @id @default(cuid())
  lenderId   String
  lender     Lender            @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  title      String?
  isPrimary  Boolean           @default(true)
  confidence ContactConfidence
  sourceUrl  String?
  sourceNote String? // e.g. "found on /partner-with-us page" or "entered manually by <admin>"
  optedOut   Boolean           @default(false)
  optedOutAt DateTime?

  messages OutreachMessage[]

  createdAt DateTime @default(now())

  @@unique([lenderId, email])
  @@index([email])
}

model OutreachMessage {
  id        String            @id @default(cuid())
  lenderId  String
  lender    Lender            @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?          @relation(fields: [contactId], references: [id])
  threadId  String // groups a proposal with its follow-ups and replies; = id of the first message in the thread
  direction MessageDirection
  kind      MessageKind
  status    MessageStatus     @default(DRAFT)

  subject String
  body    String
  bodyHtml String?

  aiModel       String?
  aiPrompt      String? @db.Text
  editedByHuman Boolean @default(false)

  approvedBy String? // admin email
  approvedAt DateTime?
  skippedReason String?

  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  bouncedAt       DateTime?
  bounceReason    String?
  resendMessageId String?
  failedReason    String?

  // inbound only
  inReplyToMessageId String?
  fromEmail           String?
  toEmail             String?
  rawHeaders          Json?
  replyClassification ReplyClassification?
  classificationNote  String?
  requiresApproval    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lenderId])
  @@index([threadId])
  @@index([status])
  @@index([resendMessageId])
}

model Note {
  id        String   @id @default(cuid())
  lenderId  String
  lender    Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([lenderId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  lenderId  String?
  lender    Lender?  @relation(fields: [lenderId], references: [id], onDelete: SetNull)
  actor     String // admin email, or "system" for cron/automation
  action    String // e.g. "contact.discovered", "message.approved", "message.sent", "reply.classified"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([lenderId])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Dashboard platform: customer, channel-partner and admin ("console") apps.
// Separate from the outreach models above (that CRM manages lender
// partnerships; this manages borrowers, partners and their applications).
// Own session/auth (src/server/auth), own login at /login, /partners/login
// and /console/login — deliberately not merged with AdminUser/outreach auth.
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  FINANCE
  SUPPORT
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PartnerKycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCS_REQUIRED
  DOCS_SUBMITTED
  LENDER_MATCHING
  SENT_TO_LENDER
  LENDER_REVIEW
  APPROVED
  SANCTIONED
  DISBURSED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum DocumentType {
  PAN
  AADHAAR
  PHOTO
  INCOME_PROOF
  BANK_STATEMENT
  ITR
  GST_CERTIFICATE
  PROPERTY_PAPER
  BUSINESS_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CommissionStatus {
  ACCRUED
  APPROVED
  PAID
  DISPUTED
  VOID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  APPLICATION_STATUS
  DOCUMENT_REVIEW
  KYC_REVIEW
  COMMISSION
  PAYOUT
  ACCOUNT
  BROADCAST
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  phone           String?
  passwordHash    String
  name            String
  role            UserRole
  adminRole       AdminRole?
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  partnerProfile  PartnerProfile?
  customerProfile CustomerProfile?

  applicationsAsCustomer LoanApplication[] @relation("ApplicationCustomer")
  applicationsAsPartner  LoanApplication[] @relation("ApplicationPartner")
  applicationsAssigned   LoanApplication[] @relation("ApplicationAssignedAdmin")
  applicationNotes       ApplicationNote[]
  applicationEvents      ApplicationStatusEvent[]

  documentsOwned    Document[] @relation("DocumentOwner")
  documentsReviewed Document[] @relation("DocumentReviewer")

  commissionEntries CommissionEntry[]
  payouts           Payout[]          @relation("PayoutPartner")
  payoutsProcessed  Payout[]          @relation("PayoutProcessedBy")

  notifications Notification[]
  auditLogs     AuditLog[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([role])
  @@index([status])
}

model PartnerProfile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName               String?
  panNumber              String?
  gstNumber              String?
  city                   String?
  referralCode           String           @unique
  kycStatus              PartnerKycStatus @default(NOT_SUBMITTED)
  kycNote                String?
  bankAccountName        String?
  bankAccountNumber      String?
  bankIfsc               String?
  commissionRateOverride Float?
  approvedByAdminId      String?
  approvedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([kycStatus])
}

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           String?
  panNumber      String?
  dateOfBirth    DateTime?
  employmentType String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LoanApplication {
  id                String            @id @default(cuid())
  code              String            @unique
  customerId        String
  customer          User              @relation("ApplicationCustomer", fields: [customerId], references: [id])
  partnerId         String?
  partner           User?             @relation("ApplicationPartner", fields: [partnerId], references: [id])
  assignedAdminId   String?
  assignedAdmin     User?             @relation("ApplicationAssignedAdmin", fields: [assignedAdminId], references: [id])
  productSlug       String
  requestedAmount   Float
  city              String
  employmentType    String?
  status            ApplicationStatus @default(DRAFT)
  assignedLenderSlug String?
  sanctionedAmount  Float?
  rejectionReason   String?
  submittedAt       DateTime?
  decisionAt        DateTime?
  disbursedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  documents         Document[]
  events            ApplicationStatusEvent[]
  notes             ApplicationNote[]
  commissionEntry   CommissionEntry?

  @@index([customerId])
  @@index([partnerId])
  @@index([status])
  @@index([assignedAdminId])
}

model ApplicationStatusEvent {
  id            String             @id @default(cuid())
  applicationId String
  application   LoanApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorUserId   String?
  actor         User?              @relation(fields: [actorUserId], references: [id])
  actorRole     UserRole?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model ApplicationNote {
  id                String          @id @default(cuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorUserId      String
  author            User            @relation(fields: [authorUserId], references: [id])
  body              String
  visibleToCustomer Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([applicationId])
}

model Document {
  id               String          @id @default(cuid())
  ownerUserId      String
  owner            User            @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  applicationId    String?
  application      LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type             DocumentType
  status           DocumentStatus  @default(PENDING_REVIEW)
  fileUrl          String
  fileName         String
  mimeType         String
  sizeBytes        Int
  reviewedByAdminId String?
  reviewer         User?           @relation("DocumentReviewer", fields: [reviewedByAdminId], references: [id])
  reviewNote       String?
  uploadedAt       DateTime        @default(now())
  reviewedAt       DateTime?

  @@index([ownerUserId])
  @@index([applicationId])
  @@index([status])
}

model CommissionEntry {
  id            String            @id @default(cuid())
  partnerId     String
  partner       User              @relation(fields: [partnerId], references: [id])
  applicationId String            @unique
  application   LoanApplication   @relation(fields: [applicationId], references: [id])
  baseAmount    Float
  rate          Float
  amount        Float
  status        CommissionStatus  @default(ACCRUED)
  payoutId      String?
  payout        Payout?           @relation(fields: [payoutId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([partnerId])
  @@index([status])
}

model Payout {
  id                 String       @id @default(cuid())
  partnerId          String
  partner            User         @relation("PayoutPartner", fields: [partnerId], references: [id])
  periodLabel        String
  totalAmount        Float
  status             PayoutStatus @default(PENDING)
  reference          String?
  processedByAdminId String?
  processedByAdmin   User?        @relation("PayoutProcessedBy", fields: [processedByAdminId], references: [id])
  processedAt        DateTime?
  createdAt          DateTime     @default(now())

  entries CommissionEntry[]

  @@index([partnerId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   UserRole?
  action      String
  entityType  String?
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model LenderOpsSetting {
  lenderSlug              String   @id
  isAcceptingApplications Boolean  @default(true)
  internalNote            String?
  updatedAt               DateTime @updatedAt
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  purpose    String // "verify_email" | "claim_account"
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Submissions from the public marketing forms (loan enquiry, partner
// interest, callback, contact). Written by the lead pipeline in
// src/lib/leads/store.ts as one more sink alongside the notification email,
// and worked from /console/leads. "Website" in the name keeps it distinct
// from the outreach CRM's Lender/Contact models above, which are about
// recruiting lenders, not inbound enquiries.

enum WebsiteLeadKind {
  LOAN_ENQUIRY
  PARTNER_INTEREST
  CALLBACK
  CONTACT
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

model WebsiteLead {
  id                     String            @id @default(cuid())
  leadId                 String            @unique // the pipeline's uuid; links /apply step 1 and step 2
  kind                   WebsiteLeadKind
  status                 WebsiteLeadStatus @default(NEW)
  name                   String?
  phone                  String?
  email                  String?
  city                   String?
  productSlug            String?
  amount                 Float?
  source                 String?
  page                   String?
  data                   Json // every field the form captured, merged across events
  qualifiedAt            DateTime?
  assignedAdminId        String?
  internalNote           String?
  convertedUserId        String?
  convertedApplicationId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
}
