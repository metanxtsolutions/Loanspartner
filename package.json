  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:copy": "tsx scripts/check-copy.ts",
    "test:resend": "tsx --env-file=.env.local scripts/test-resend.ts",
