    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "outreach:seed": "tsx --env-file=.env.local scripts/outreach/seed-lenders.ts",
    "outreach:discover-contacts": "tsx --env-file=.env.local scripts/outreach/discover-contacts.ts",
    "outreach:create-admin": "tsx --env-file=.env.local scripts/outreach/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.18.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "imapflow": "^1.0.191",
    "lucide-react": "^1.41.0",
    "mailparser": "^3.7.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
