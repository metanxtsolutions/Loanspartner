# Lead sinks (server only). Any combination; all optional.
# 1) JSON webhook: Google Apps Script, Zapier, Make, n8n, or your CRM
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Shared counter for the lead form rate limit. On Vercel these are injected
# automatically by connecting an Upstash Redis store under Storage, so leave
# them blank there. Set them by hand only for a database provisioned elsewhere.
# Without either pair the limiter falls back to a per-process map, which does
# little on serverless; the honeypot and timing checks are unaffected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 2) Email via Resend
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL="LoansPartner Leads <leads@loanspartner.in>"
# 3) Local JSONL file (defaults to .data/leads.jsonl in development)
LEADS_FILE=

# Lender partnership outreach CRM (/admin/outreach). See README "Outreach
# platform" section for the full setup and go-live checklist.
# 1) Database. Any managed Postgres works; Neon integrates cleanly with Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 2) AI drafting and reply classification (Gemini, free tier, no card needed)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 3) Admin login. Create the first admin with: pnpm outreach:create-admin
ADMIN_SESSION_SECRET=
# 4) Outbound send identity, reusing the Resend account above
OUTREACH_FROM_EMAIL="LoansPartner Partnerships <partnerships@loanspartner.in>"
OUTREACH_REPLY_TO=partnerships@loanspartner.in
# 5) Inbound reply monitoring: IMAP on the mailbox OUTREACH_REPLY_TO points at.
# Use an app password, never the account password.
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=
# 6) Shared secret Vercel Cron sends as a Bearer token to the cron routes
CRON_SECRET=
# Signing secret for the Resend webhook (delivered/opened/bounced/complained),
# from the Resend dashboard's webhook settings. Starts with whsec_.
RESEND_WEBHOOK_SECRET=
# 7) Sending limits (safe defaults; tune once the mailbox is warmed up)
OUTREACH_DAILY_SEND_LIMIT=40
OUTREACH_SEND_DELAY_SECONDS=45
OUTREACH_FOLLOWUP_DAYS="4,9,16"
